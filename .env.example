# The Movie Database (TMDB) API Read Access Token (v4 "Bearer" token)
# Get one free at: https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Optional: MDBList API key for IMDb / Rotten Tomatoes / Metacritic ratings
# Get a free key at: https://mdblist.com/preferences/
MDBLIST_API_KEY=

# Google Gemini API Key for Grey (AI Cinema Curator & Film Archivist)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
